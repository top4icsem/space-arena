{
  "name": "space-arena",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "description": "Space Arena Lab 07 - Vitest, fast-check, Playwright, V8 profiling and bounded pools",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run typecheck && npm run build -w client",
    "start": "npm run start -w server",
    "test": "vitest run --config vitest.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:legacy && npm run test:coverage && npm run build",
    "bench:rss": "node server/scripts/rss-benchmark.mjs",
    "bench:slow": "node server/scripts/slow-http.mjs",
    "bench:wire": "node scripts/measure-wire.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:legacy": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test client/tests/*.test.js server/test/*.test.js shared/test/*.test.js shared/test/types-lab06.test.ts server/test/zod-protocol-lab06.test.ts",
    "test:e2e": "playwright test",
    "check:ci": "npm run check && npm run test:e2e",
    "bench:clients": "node scripts/load-clients.mjs",
    "bench:world": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/bench-world.mjs",
    "bench:browser": "node scripts/profile-browser.mjs",
    "bench:worker": "node scripts/benchmark-worker.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/parser": "^8.46.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "vitest": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.2.0",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "zod": "^4.1.0"
  }
}
