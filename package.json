{
  "name": "space-arena",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "description": "Space Arena Lab 04 — Node.js HTTP, rooms, WebSocket chat and streaming match logs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "node --test client/tests/*.test.js server/test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "bench:rss": "node server/scripts/rss-benchmark.mjs",
    "bench:slow": "node server/scripts/slow-http.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
