{
  "name": "space-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Space Arena: lab 01 foundation of an eight-lab JavaScript multiplayer game",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "vite": "^7.2.2"
  },
  "engines": { "node": ">=22.12" }
}
