# Local development: localhost can omit ALLOWED_ORIGINS; production must set exact origins.
HOST=127.0.0.1
PORT=3000
LOG_DIR=server/logs
MAX_ROOMS=24
MAX_PLAYERS=8
RATE_PER_SECOND=12
MAX_MESSAGE_BYTES=2048
MAX_CONNECTIONS_PER_IP=8
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BUILD_SHA=local
BUILD_TAG=development
